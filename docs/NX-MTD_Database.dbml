Ref FK_OM_Material: OrderMaterial.MaterialId > Material.MaterialId
Ref FK_MIL_Material: MaterialIssueLine.MaterialId > Material.MaterialId
Ref FK_CL_Material: CuttingLay.FabricMaterialId > Material.MaterialId
Ref FK_SB_Material: StockBalance.MaterialId > Material.MaterialId
Ref FK_RequestLine_Material: RequestLine.MaterialId > Material.MaterialId
Ref FK_CHL_Handover: CutHandoverLine.CutHandoverId > CutHandover.CutHandoverId
Ref FK_STL_Stocktake: StocktakeLine.StocktakeId > Stocktake.StocktakeId
Ref FK_POL_PO: PurchaseOrderLine.PurchaseOrderId > PurchaseOrder.PurchaseOrderId
Ref FK_MR_PO: MaterialReceipt.PurchaseOrderId > PurchaseOrder.PurchaseOrderId
Ref FK_PO_Supplier: PurchaseOrder.SupplierId > Supplier.SupplierId
Ref FK_PV_Product: ProductVariant.ProductId > Product.ProductId
Ref FK_PC_Product: ProductComponent.ProductId > Product.ProductId
Ref FK_WO_Product: WorkOrder.ProductId > Product.ProductId
Ref FK_OG_Product: OperationGroup.ProductId > Product.ProductId
Ref FK_Operation_Product: Operation.ProductId > Product.ProductId
Ref FK_FGH_Product: FgHandover.ProductId > Product.ProductId
Ref FK_Kpi_Product: KpiTarget.ProductId > Product.ProductId
Ref FK_MC_Product: MonthlyCost.ProductId > Product.ProductId
Ref FK_BER_Product: BreakEvenResult.ProductId > Product.ProductId


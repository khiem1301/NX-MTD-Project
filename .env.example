# Sao chép thành .env (cùng thư mục với docker-compose.yml) rồi điền giá trị thật.
# KHÔNG commit file .env. Tránh các ký tự ; $ " ' = # trong mật khẩu/khóa (làm hỏng connection string / compose).

# Mật khẩu tài khoản sa của SQL Server (BẮT BUỘC điền): >= 8 ký tự, có chữ hoa, chữ thường, số
DB_SA_PASSWORD=

# Khóa ký JWT: >= 32 ký tự ngẫu nhiên. Tạo bằng: openssl rand -base64 48 | tr -d '+/=\n'
JWT_KEY=

# Địa chỉ người dùng truy cập (dùng cho CORS). Có domain/HTTPS thì đổi, ví dụ https://nxmtd.congty.vn
PUBLIC_URL=http://localhost

# Cổng web trên server (80 = mặc định của HTTP)
WEB_PORT=80

# Cổng SQL Server mở trên chính máy chủ (chỉ 127.0.0.1). Đổi nếu máy đã có SQL Server dùng cổng 1433.
DB_PORT=1433

# Express (miễn phí, dùng được cho production) | Developer (chỉ test) | Standard (cần license)
MSSQL_PID=Express

# Mật khẩu đặt cho các tài khoản seed (ADMIN, QUANDOC, ...) ở lần chạy seed đầu tiên.
# Đặt mạnh TRƯỚC khi chạy seed; sau đó nên đổi lại từng tài khoản trong hệ thống.
SEED_DEFAULT_PASSWORD=

# Khóa Google Gemini (tính năng AI gợi ý bậc thợ). Để trống nếu không dùng.
GEMINI_API_KEY=

# Production = bình thường. Chỉ đặt Development MỘT LẦN ở bước seed mật khẩu, xong đổi lại Production.
ASPNETCORE_ENVIRONMENT=Production
